# LLM extraction
GEMINI_API_KEY=
LLM_API_KEY=
GEMINI_API_BASE=https://api-666.cc/v1
GEMINI_MODEL=count.gmcli-gemini-3-flash-preview

# Phase B conditional second-model collaboration (disabled by default).
# Its candidates are always rechecked by the deterministic Phase-A verifier.
SECOND_LLM_ENABLED=false
SECOND_LLM_API_KEY=
SECOND_LLM_API_BASE=https://api.deepseek.com
SECOND_LLM_MODEL_ID=deepseek-v4-flash
SECOND_LLM_MODE=conditional
SECOND_LLM_TIMEOUT=180

# Agent v3 dual-model rule learning and adjudication. Credentials are read only
# from the process environment/ignored local .env and never stored in bundles.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
ALIYUN_MAAS_API_KEY=
ALIYUN_MAAS_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
AUX_PRIMARY_MODEL=deepseek-v4-flash
AUX_CRITIC_MODEL=qwen-flash

# Frozen, verifier-safe rule memory. Keep off for legacy compatibility.
RULE_MEMORY_MODE=off
RULE_BUNDLE=
RULE_LEARNING_MODE=off
RULE_MAX_CONTEXT_TOKENS=1200
RULE_MAX_RULES_PER_ARTICLE=8
RULE_MAX_INDUCTION_ROUNDS=3

# BioRED-style entity-pair relation core. `shadow` does not change production
# relations. `active` is restricted to Neo4j dry-run until calibrated.
PAIR_CLASSIFIER_MODE=shadow
PAIR_CLASSIFIER_BACKEND=deterministic
PAIR_CLASSIFIER_MODEL_PATH=
PAIR_CLASSIFIER_HIGH_CONFIDENCE=0.78
PAIR_CLASSIFIER_RELATION_THRESHOLD=0.48
PAIR_CLASSIFIER_UNCERTAINTY_FLOOR=0.35
PAIR_CLASSIFIER_MAX_CANDIDATES=64
PAIR_CLASSIFIER_MAX_LLM_CANDIDATES=12

# Phase C bounded read-only Neo4j RAG (disabled by default).
NEO4J_RAG_ENABLED=false
RAG_MAX_ENTITIES=12
RAG_MAX_CANDIDATES_PER_ENTITY=3
RAG_MAX_TOTAL_CANDIDATES=20
RAG_MAX_NEIGHBORS_PER_CANDIDATE=4
RAG_MAX_EVIDENCE_CHARS=500
RAG_MAX_TOTAL_CHARS=6000

# Agent action policy: precision | shadow-agent | recall.
# Production default is precision; shadow-agent evaluates additions but cannot write them.
AGENT_MODE=precision
# Central Agent v2: legacy | agent-v2-shadow | agent-v2.
# Active v2 is dry-run only until the 50-article acceptance gates pass.
AGENT_EXECUTION_MODE=legacy
AGENT_BUDGET_PROFILE=quality
# Zero keeps the adaptive FAST/STANDARD/DEEP defaults.
AGENT_MAX_ACTIONS=0
AGENT_MAX_AUX_REMOTE_CALLS=0
AGENT_MAX_NEO4J_CALLS=0
AGENT_SOFT_TIMEOUT=0
AGENT_HARD_TIMEOUT=180
GOLDEN_SHOT_MAX_EXAMPLES=4
EXTRACTION_CHUNK_MAX_CHARS=1800
EXTRACTION_CHUNK_COMPLEXITY_MIN_CHARS=1400
EXTRACTION_CHUNK_MAX_CHUNKS=3

# Lightweight extraction cache. `memory` is the production default and creates
# no files. Use `persistent` only for repeated experiments on fixed candidates.
EXTRACTION_CACHE_MODE=memory
EXTRACTION_CACHE_PATH=.cache/langextract_candidates.sqlite3
EXTRACTION_CACHE_MEMORY_ENTRIES=256
EXTRACTION_CACHE_MAX_ENTRIES=2000
EXTRACTION_CACHE_MAX_MB=200
EXTRACTION_CACHE_TTL_DAYS=30
EXTRACTION_INNER_MAX_WORKERS=2

# Optional Neo4j access. Required for KG context reads or write-back.
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=
