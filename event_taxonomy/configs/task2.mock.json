{
  "schema_version": "event-taxonomy-induction/1",
  "dataset": "../examples/synthetic/dataset.json",
  "output_root": "../runs",
  "require_semantic_input_frozen": true,
  "provider": {"kind": "mock", "plan_file": "../examples/synthetic/mock_plan.json"},
  "prompts": {
    "diagnosis": "../prompts/diagnosis.v1.txt",
    "induction": "../prompts/induction.v1.txt",
    "validation": "../prompts/validation.v1.txt"
  },
  "stages": {
    "diagnosis": {"model": "synthetic-rule-mock-v1", "temperature": 0, "max_tokens": 3000},
    "induction": {"model": "synthetic-rule-mock-v1", "temperature": 0, "max_tokens": 4000},
    "validation": {"model": "synthetic-rule-mock-v1", "temperature": 0, "max_tokens": 4000}
  },
  "clustering": {"method": "llm_guided", "vectors_file": null, "cosine_threshold": 0.82, "max_cluster_size": 20},
  "thresholds": {"diagnosis_confidence": 0.65, "induction_confidence": 0.65, "validation_confidence": 0.75},
  "context": {"evidence_per_concept": 3, "max_ancestor_paths": 32, "max_characters": 200000},
  "limits": {"iterations_per_parent": 6, "candidate_attempts": 3, "max_depth": 12,
             "context_visits_per_node": 4, "new_nodes": 100, "llm_calls": 300}
}
